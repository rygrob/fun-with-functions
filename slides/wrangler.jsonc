// Cloudflare Workers static assets: the built deck, on its own subdomain.
//   python3 build.py && npx wrangler deploy
{
  "name": "fun-with-functions",
  "compatibility_date": "2026-10-06",
  "routes": [{ "pattern": "functions.rygrob.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
