{"tex_setup":"x - \\textcolor{#2a78d6}{\\tfrac{1}{6}}\\,x^3 + \\textcolor{#2a78d6}{\\tfrac{1}{120}}\\,x^5 \\approx \\frac{\\textcolor{#eb6834}{p_1} x + \\textcolor{#eb6834}{p_3} x^3}{\\textcolor{#1baf7a}{1 + q_2 x^2}}","tex_multiply":"(\\textcolor{#1baf7a}{1 + q_2 x^2})\\,(x - \\textcolor{#2a78d6}{\\tfrac{1}{6}}\\,x^3 + \\textcolor{#2a78d6}{\\tfrac{1}{120}}\\,x^5) = \\textcolor{#eb6834}{p_1} x + \\textcolor{#eb6834}{p_3} x^3 + O(x^7)","tex_expand":"= x - \\textcolor{#2a78d6}{\\tfrac{1}{6}}\\,x^3 + \\textcolor{#2a78d6}{\\tfrac{1}{120}}\\,x^5 + \\textcolor{#1baf7a}{q_2}\\,x^3 - \\textcolor{#2a78d6}{\\tfrac{1}{6}}\\,\\textcolor{#1baf7a}{q_2}\\,x^5 + \\textcolor{#2a78d6}{\\tfrac{1}{120}}\\,\\textcolor{#1baf7a}{q_2}\\,x^7","tex_grouped":"\\begin{array}{rllll}\\textcolor{#8a8985}{\\text{product}} & x & + \\,(\\textcolor{#1baf7a}{q_2} - \\textcolor{#2a78d6}{\\tfrac{1}{6}})\\,x^3 & + \\,(\\textcolor{#2a78d6}{\\tfrac{1}{120}} - \\textcolor{#2a78d6}{\\tfrac{1}{6}}\\,\\textcolor{#1baf7a}{q_2})\\,x^5 & + \\;O(x^7) \\\\[6pt]\\textcolor{#8a8985}{\\text{numerator}} & \\textcolor{#eb6834}{p_1}\\,x & + \\,\\textcolor{#eb6834}{p_3}\\,x^3 & + \\,0\\,x^5 & + \\;O(x^7)\\end{array}","tex_match":"\\begin{alignedat}{2}x^1&:\\quad & \\textcolor{#2a78d6}{1} &= \\textcolor{#eb6834}{p_1} \\\\x^3&:\\quad & \\textcolor{#1baf7a}{q_2} - \\textcolor{#2a78d6}{\\tfrac{1}{6}} &= \\textcolor{#eb6834}{p_3} \\\\x^5&:\\quad & \\textcolor{#2a78d6}{\\tfrac{1}{120}} - \\textcolor{#2a78d6}{\\tfrac{1}{6}}\\,\\textcolor{#1baf7a}{q_2} &= 0\\end{alignedat}","tex_solve":"\\textcolor{#1baf7a}{q_2} = \\tfrac{1}{20}, \\quad \\textcolor{#eb6834}{p_1} = 1, \\quad \\textcolor{#eb6834}{p_3} = -\\tfrac{7}{60}\\quad\\Rightarrow\\quad \\sin x \\approx x\\,\\frac{60 - 7\\,x^{2}}{60 + 3\\,x^{2}}"}
